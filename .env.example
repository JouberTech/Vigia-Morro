# O protótipo funciona sem variáveis e sem Firebase: apenas dados MOCK.
# Configuração pública do aplicativo Web Firebase, para integração futura.
# Nunca inclua chaves privadas, contas de serviço ou credenciais ESP32.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# GeoJSON oficial de áreas de risco, validado e servido com CORS.
VITE_RISK_GEOJSON_URL=
